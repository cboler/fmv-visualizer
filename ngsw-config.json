{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/sample-mission.webm",
          "/sample-telemetry.csv",
          "/offline-map.geojson",
          "/maplibre/*.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "urls": ["https://tiles.openfreemap.org/**"],
      "cacheConfig": {
        "maxAge": "7d",
        "strategy": "performance",
        "maxSize": 256
      },
      "name": "street-tiles"
    }
  ]
}
